{
  // İzmir Go API on the Cloudflare Workers FREE plan.
  // Static data (public/data) is generated by `npm run bundle` and served as assets;
  // only /api/* requests run the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izmir-go-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "vars": {
    "IZMIR_OPENAPI_URL": "https://openapi.izmir.bel.tr/api",
    "PHOTON_URL": "https://photon.komoot.io"
  },
  "observability": { "enabled": true }
}
