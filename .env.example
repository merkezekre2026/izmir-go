# Copy to .env for local development. Placeholders only; never commit real secrets.

# Database (matches infra/compose/compose.yaml defaults for local dev)
IZMIRGO_DATABASE_URL=postgresql+psycopg://izmirgo:izmirgo@localhost:5432/izmirgo

# OpenTripPlanner base URL (GTFS GraphQL API lives under /otp/gtfs/v1)
IZMIRGO_OTP_URL=http://localhost:8080

# İzmir OpenAPI (anonymous access, no key required as of 2026-10-24)
IZMIRGO_IZMIR_OPENAPI_URL=https://openapi.izmir.bel.tr/api

# Geocoder (Photon). Use a self-hosted instance in production.
IZMIRGO_PHOTON_URL=https://photon.komoot.io

# Where ingestion stores raw snapshots, merged feeds and OTP graphs
IZMIRGO_DATA_DIR=./var

# Logging: json | console
IZMIRGO_LOG_FORMAT=console
IZMIRGO_LOG_LEVEL=INFO

# Environment name: dev | staging | prod
IZMIRGO_ENV=dev
